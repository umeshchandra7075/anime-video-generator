{
  "name": "anime-video-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=prisma/schema.production.prisma && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "worker:generation": "tsx src/workers/generation-worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma db push --schema=prisma/schema.production.prisma",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:engine": "vitest run tests/engine",
    "test:video": "node scripts/generate-test-video.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.637.0",
    "@aws-sdk/s3-request-presigner": "3.637.0",
    "@google/genai": "^2.23.0",
    "@huggingface/inference": "^4.13.30",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "2.4.3",
    "bullmq": "5.12.12",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "fluent-ffmpeg": "2.1.3",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "nanoid": "5.0.7",
    "next": "14.2.35",
    "pino": "9.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "3.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/fluent-ffmpeg": "2.1.24",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.41",
    "prisma": "^5.19.1",
    "tailwindcss": "3.4.10",
    "tsx": "4.19.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}


