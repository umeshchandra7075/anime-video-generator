// SQLite by default so local development needs zero external services.
// Swap the datasource to postgresql (and re-run `prisma migrate dev`) for
// production - see README "Production database" section. SQLite does not
// support native enums or scalar list (String[]) columns, so this schema
// deliberately uses plain String columns for both; the allowed values are
// enforced in application code (src/lib/domain/enums.ts), not the DB engine.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// AUTH
// =====================================================================

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  emailVerifiedAt    DateTime?
  role               String   @default("USER") // "USER" | "ADMIN" - see src/lib/domain/enums.ts
  credits            Int      @default(50)
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  sessions           Session[]
  projects           Project[]
  usageRecords       UsageRecord[]
  auditLogs          AuditLog[]

  @@index([email])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id                  String   @id @default(uuid())
  userId              String
  refreshTokenHash    String   @unique
  userAgent           String?
  ipAddress           String?
  revokedAt           DateTime?
  replacedBySessionId String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================================================
// PROJECTS / GENERATION PIPELINE
// =====================================================================

model Project {
  id              String    @id @default(uuid())
  userId          String
  title           String
  story           String
  language        String
  animeStyle      String
  duration        String
  aspectRatio     String
  voiceGender     String
  voiceStyle      String
  subtitlesOn     Boolean   @default(true)
  subtitleLang    String?
  musicMood       String?
  status          String    @default("DRAFT") // see ProjectStatus in enums.ts
  structuredStory String?   // JSON-encoded StructuredStory - see src/lib/domain/json.ts
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters     Character[]
  scenes         Scene[]
  generationJobs GenerationJob[]
  audioAssets    AudioAsset[]
  videoAssets    VideoAsset[]
  subtitles      Subtitle[]
  usageRecords   UsageRecord[]

  @@index([userId])
  @@index([status])
}

model Character {
  id                String   @id @default(uuid())
  projectId         String
  name              String
  ageRange          String?
  gender            String?
  appearance        String?
  hair              String?
  eyes              String?
  clothes           String?
  accessories       String?
  personality       String?
  styleDescription  String?
  referenceImageUrl String?
  providerMetadata  String?  // JSON-encoded
  voiceConfig       String?  // JSON-encoded CharacterVoiceConfig (see src/lib/domain/characterVoice.ts) - optional per-character ElevenLabs override, falls back to ELEVENLABS_DEFAULT_VOICE_ID/ELEVENLABS_MODEL_ID when absent
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Scene {
  id               String   @id @default(uuid())
  projectId        String
  sceneNumber      Int
  description      String?
  location         String?
  timeOfDay        String?
  characterIds     String?  // JSON-encoded string[]
  cameraAngle      String?
  cameraMovement   String?
  lighting         String?
  mood             String?
  dialogue         String?  // JSON-encoded {character,line}[]
  narration        String?
  soundEffects     String?  // JSON-encoded string[]
  musicMood        String?
  imagePrompt      String?
  animationPrompt  String?
  animationNegativePrompt String? // what the AI video provider should avoid (identity drift, extra limbs, jump cuts, etc.)
  timeline         String?  // JSON-encoded SceneTimeline (src/lib/engine/types.ts): the ONE authoritative timeline - dialogue windows from MEASURED audio, visemes, actor tracks, camera, SFX, music. Null until voice generation has run.
  componentIssues  String?  // JSON-encoded {component,code,message}[]: per-component failures/warnings (e.g. one dialogue line's TTS failed) so a partial failure never destroys the scene or project.
  estimatedSeconds Int?
  status           String   @default("PENDING") // see SceneStatus in enums.ts
  errorMessage     String?
  retryCount       Int      @default(0)
  orderIndex       Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  SceneAsset[]

  @@index([projectId])
  @@unique([projectId, sceneNumber])
}

model SceneAsset {
  id               String   @id @default(uuid())
  sceneId          String
  type             String   // "IMAGE" | "VIDEO_CLIP" | "VOICE_AUDIO" | "LIP_SYNC_CLIP"
  storageKey       String
  providerName     String?
  providerJobId    String?
  providerMetadata String?  // JSON-encoded
  createdAt        DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

// A durable job record - the single source of truth for generation progress.
// Designed to survive worker restarts: `leaseOwner`/`heartbeatAt` let a
// recovery sweep detect and requeue jobs whose worker died mid-run, and
// `activeKey` gives a DB-level (not just application-level) idempotency
// guarantee against duplicate concurrent generation for the same project.
model GenerationJob {
  id                String    @id @default(uuid())
  projectId         String
  activeKey         String?   @unique // = projectId while non-terminal, else null; enforces "one active job per project" at the DB layer
  status            String    @default("QUEUED") // see JobStatus in enums.ts
  currentStage      String?
  progress          Int       @default(0)
  attemptCount      Int       @default(0)
  maxAttempts       Int       @default(3)
  errorCode         String?
  errorMessage      String?
  cancelRequested   Boolean   @default(false)
  leaseOwner        String?   // worker instance id currently processing this job
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  availableAt       DateTime  @default(now()) // supports scheduled retry backoff
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  JobEvent[]

  @@index([projectId])
  @@index([status])
  @@index([availableAt])
}

model JobEvent {
  id        String   @id @default(uuid())
  jobId     String
  stage     String
  message   String?
  createdAt DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model AudioAsset {
  id               String   @id @default(uuid())
  projectId        String
  type             String   // "NARRATION" | "DIALOGUE" | "MUSIC" | "SFX"
  storageKey       String
  providerName     String?
  providerMetadata String?  // JSON-encoded
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model VideoAsset {
  id           String   @id @default(uuid())
  projectId    String
  storageKey   String
  durationSecs Int?
  resolution   String?
  format       String   @default("mp4")
  fileSizeBytes Int?
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Subtitle {
  id         String   @id @default(uuid())
  projectId  String
  language   String
  storageKey String
  format     String   @default("srt")
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model UsageRecord {
  id          String   @id @default(uuid())
  userId      String
  projectId   String?
  creditsUsed Int
  reason      String
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  planName  String
  status    String
  renewsAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  String?  // JSON-encoded
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
