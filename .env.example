# =====================================================================
# DATABASE - SQLite by default so local dev needs zero external services.
# Point this at a PostgreSQL URL in production and re-run `prisma migrate dev`
# against that provider (see README "Production database & storage").
# =====================================================================
DATABASE_URL="file:./prisma/dev.db"

# =====================================================================
# AUTH - generate both with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# =====================================================================
AUTH_ACCESS_TOKEN_SECRET=65zuqCyi24DBuhKA7ANq0WcTGcFju7yP5Jz/Sd5y6sk=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# =====================================================================
# APP
# =====================================================================
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# In development only: register/forgot-password responses include the
# verification/reset link directly in the JSON body (and the UI displays it)
# so you never need a real mailbox to test the flow. Automatically ignored
# if NODE_ENV=production, regardless of this value.
DEV_EXPOSE_VERIFICATION_LINKS=true

# =====================================================================
# JOB QUEUE - local dev needs nothing here. The worker polls the database
# directly (see src/lib/queue/jobQueueAdapter.ts). Set JOB_QUEUE_DRIVER=redis
# and fill in REDIS_URL only if you want the optional low-latency dispatch
# path across multiple worker processes in production.
# =====================================================================
JOB_QUEUE_DRIVER=db-polling
REDIS_URL=

# Rate limiting (login/register/forgot-password brute-force protection):
# in-memory by default (zero dependencies, correct for a single instance).
# Set RATE_LIMIT_DRIVER=redis for multi-instance production so limits are
# shared across instances instead of tracked separately per-process.
RATE_LIMIT_DRIVER=memory

# Runs the generation worker inside the same process as `npm run dev`/`next
# start`, so one command is enough locally. Defaults to true outside
# production and false in production - set explicitly to override.
EMBEDDED_WORKER=

GENERATION_WORKER_CONCURRENCY=2
GENERATION_WORKER_POLL_MS=2000
GENERATION_WORKER_HEARTBEAT_MS=20000
GENERATION_WORKER_LEASE_MS=90000
GENERATION_WORKER_RECOVERY_MS=30000

# =====================================================================
# OBJECT STORAGE - local dev needs nothing here. Files are written under
# LOCAL_STORAGE_DIR and served through signed links via /api/files/[...path]
# (see src/lib/storage/). Set STORAGE_DRIVER=s3 and fill in the STORAGE_*
# values below for production.
# =====================================================================
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# Only used by the local driver's signed URLs; falls back to
# AUTH_ACCESS_TOKEN_SECRET if unset, but set your own before production.
STORAGE_LOCAL_SIGNING_SECRET=

STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# =====================================================================
# EMAIL - optional in development (see DEV_EXPOSE_VERIFICATION_LINKS above).
# Required in production; without it, verification/reset emails silently
# fail to send (a warning is logged, but users never receive anything).
# =====================================================================
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com

# =====================================================================
# AI PROVIDERS
# =====================================================================

# --- Text generation: OpenAI ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Image generation: OpenAI ---
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Text-to-speech: ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# Fallback voice/model used whenever a character has no voiceId/modelId of
# its own set via PATCH /api/projects/:id/characters/:characterId (see
# src/lib/domain/characterVoice.ts). Per-character overrides are stored
# server-side (Character.voiceConfig) and never touch the frontend or the
# ELEVENLABS_API_KEY.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Video generation: real AI image-to-video when configured, otherwise a
# local FFmpeg Ken-Burns (zoom/pan) fallback so generation always produces
# something. Leave VIDEO_PROVIDER empty to use only the FFmpeg fallback.
# See src/lib/ai/providers/video/ai-video-provider.ts for the request/
# response contract this adapter speaks - adjust it to match your actual
# vendor (Runway, Kling, Pika, Luma, etc.) if their field names differ.
VIDEO_PROVIDER=
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_BASE_URL=
# Optional model id sent with every request, if your vendor needs one.
VIDEO_PROVIDER_MODEL=
# Optional: override the submit/poll endpoint paths if your vendor's don't
# match the defaults below. {id} in the status path is replaced with the
# job id returned by the submit call.
VIDEO_PROVIDER_SUBMIT_PATH=/v1/videos
VIDEO_PROVIDER_STATUS_PATH=/v1/videos/{id}

# If the configured AI video provider (above) is unconfigured, times out, or
# otherwise fails, automatically fall back to the local FFmpeg Ken-Burns
# provider for that scene instead of failing the whole generation job - no
# API key or globally-installed FFmpeg required (uses the bundled
# ffmpeg-static binary, same as the local music fallback below). Set to
# "false" to make an AI provider failure fail the job instead (strict mode).
ENABLE_FFMPEG_VIDEO_FALLBACK=true

# --- Lip sync: real audio-driven lip sync when configured, NOT configured
# by default. With LIPSYNC_PROVIDER unset, generation still completes end
# to end - scenes just keep their plain animation clip from VIDEO_PROVIDER/
# FFmpeg above, with no mouth movement synced to the dialogue. There is no
# local fallback for this stage the way there is for video/music (real lip
# sync needs a trained model, not something FFmpeg alone can do credibly).
# See src/lib/ai/providers/lipsync/http-lipsync-provider.ts for the request/
# response contract this adapter speaks - adjust it to match your actual
# vendor (sync.so, D-ID, HeyGen, a hosted Wav2Lip/SadTalker, etc.) if their
# field names differ.
LIPSYNC_PROVIDER=
LIPSYNC_PROVIDER_API_KEY=
LIPSYNC_PROVIDER_BASE_URL=
# Optional model id sent with every request, if your vendor needs one.
LIPSYNC_PROVIDER_MODEL=
# Optional: override the submit/poll endpoint paths if your vendor's don't
# match the defaults below. {id} in the status path is replaced with the
# job id returned by the submit call.
LIPSYNC_PROVIDER_SUBMIT_PATH=/v1/lipsync
LIPSYNC_PROVIDER_STATUS_PATH=/v1/lipsync/{id}
# Master on/off switch, independent of whether LIPSYNC_PROVIDER is set -
# lets an operator disable lip sync (e.g. to save API cost/time) without
# touching credentials. Set to "false" to skip the stage entirely.
ENABLE_LIPSYNC=true

# --- Music/SFX generation: pluggable, NOT configured by default ---
MUSIC_PROVIDER=
MUSIC_PROVIDER_API_KEY=
MUSIC_PROVIDER_BASE_URL=

# If the primary music provider (e.g. Pollinations) is unconfigured, out of
# balance, rate-limited, or otherwise fails, automatically fall back to a
# free, local, royalty-free procedural audio generator built on the
# ffmpeg-static binary already bundled with this app - no API key, no paid
# balance, and no globally-installed FFmpeg required. Set to "false" to
# restore the old behavior of failing generation when music fails.
ENABLE_LOCAL_AUDIO_FALLBACK=true

# =====================================================================
# ANIMATION & AUDIO ENGINE (src/lib/engine) - all optional, safe defaults
# =====================================================================
# --- Voice provider: "elevenlabs" (default) | "openai". "google" / "azure" are recognised but NOT implemented
#     (selecting them fails loudly instead of silently using another voice).
TTS_PROVIDER=elevenlabs
# Per-call timeout in ms (the voice pipeline adds retry with exponential backoff on top: 3 retries).
ELEVENLABS_TIMEOUT_MS=60000
# Opt in to ElevenLabs character-level timestamps ("with-timestamps" endpoint) for word-accurate lip-sync.
# Off by default: it is not exercised against the live API in this repository's tests.
ELEVENLABS_USE_TIMESTAMPS=false
# OpenAI TTS (only used when TTS_PROVIDER=openai). Voices are names: alloy, echo, fable, onyx, nova, shimmer.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Distinct voices to cast to characters that do not have one yet (persisted per character afterwards).
# JSON array, e.g. [{"voiceId":"abc123","gender":"male"},{"voiceId":"def456","gender":"female"}]
# Without a pool (ElevenLabs), un-cast characters share the default voice and a warning is recorded.
VOICE_POOL_JSON=
# Narrator voice (defaults to the default voice).
NARRATOR_VOICE_ID=
# Parallel TTS calls.
VOICE_CONCURRENCY=3

# --- Render (defaults: 1080p, 24 fps, H.264 + AAC) ---
# RENDER_HEIGHT is the SHORT side of the frame (1080 => 1920x1080 / 1080x1920 / 1080x1080). Minimum 240.
RENDER_HEIGHT=1080
RENDER_FPS=24
RENDER_CRF=18
# Set to use a target bitrate (kbit/s) instead of CRF.
RENDER_VIDEO_BITRATE_K=
RENDER_AUDIO_BITRATE_K=192
RENDER_PRESET=medium
# Internal supersampling used by the camera engine (1 = off).
RENDER_SUPERSAMPLE=1.5
# Audio: master loudness target (LUFS), music bed level between lines (LUFS), optional dialogue denoise.
MASTER_LUFS=-16
MUSIC_LUFS=-26
AUDIO_DENOISE=false

# --- Downloading media whose URL came from a provider's API response (SSRF protection) ---
# The provider API key is only ever sent to the provider's own origin (VIDEO_/LIPSYNC_PROVIDER_BASE_URL).
# Result URLs must be https and resolve to PUBLIC addresses only; every redirect hop is re-checked.
# Optional: restrict result hosts (comma-separated; the API host is always allowed).
PROVIDER_MEDIA_HOST_ALLOWLIST=
# Optional: extra hosts that are allowed to receive the provider API key (default: none).
PROVIDER_MEDIA_AUTH_HOSTS=
PROVIDER_MEDIA_MAX_MB=300
PROVIDER_MEDIA_TIMEOUT_MS=120000
# LOCAL DEVELOPMENT ONLY (ignored when NODE_ENV=production): allow http / private addresses for a provider on localhost.
PROVIDER_MEDIA_ALLOW_PRIVATE=false

# =====================================================================
# DEVELOPMENT / MOCK MODE - must be explicitly "true" to activate, and must
# NEVER be true in production. Reserved for future use; no code path
# currently fabricates AI output even when this is true (see README).
# =====================================================================
MOCK_AI=false
